# ==============================================================================
# FMS Production Environment Configuration (Docker Compose)
# ==============================================================================

# Application Port on Host (Default: 3000)
PORT=3000
APP_URL=http://localhost:3000

# NextAuth Secret (CRITICAL: Generate with `openssl rand -base64 32`)
AUTH_SECRET=replace_with_a_secure_random_32_bytes_base64_string

# PostgreSQL Credentials (Internal to Docker network)
POSTGRES_DB=fms_prod
POSTGRES_USER=vibe
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_HOST_PORT=5443

# SMTP Email Configuration (Optional - leave empty to log to stdout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FMS Platform <no-reply@localhost>

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Bootstrap Initial Super Admin (For `npm run db:bootstrap`)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-to-strong-password-min-12-chars
BOOTSTRAP_TENANT_CODE=ODC
BOOTSTRAP_TENANT_NAME_TH=วิทยาลัยการจัดการอภิธรรม
BOOTSTRAP_TENANT_NAME_EN=Ongkarak Dhammaduta College
